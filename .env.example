PIPELINE_STALLED_SEQUENCE_ID=""

# ── Observabilidade e alertas do motor de envios ──────────────────────────
# Sentry (server-side, via src/instrumentation.ts). Vazio = desligado.
SENTRY_DSN=""
# Destinos dos alertas de saúde da fila (checados pelo cron recover a cada
# 5 min): e-mails e números WhatsApp (E.164), separados por vírgula.
# Vazio = alerta só vai pro Sentry/console.
ALERTS_EMAILS=""
ALERTS_WHATSAPP_TO=""
# Limiares (opcionais — defaults em src/lib/marketing/alerts.ts):
# ALERTS_QUEUE_DEAD_THRESHOLD=5        jobs dead/hora
# ALERTS_QUEUE_STUCK_THRESHOLD=3       jobs presos em 'claimed' >15min
# ALERTS_DRAIN_STALL_MINUTES=5         drain sem executar há N min
# ALERTS_QUEUE_BACKLOG_MINUTES=15      job pendente esperando há N min
# ALERTS_PROVIDER_MIN_SAMPLE=10        amostra mínima p/ taxa de erro
# ALERTS_PROVIDER_ERROR_RATE=0.25      taxa de erro Twilio/Brevo (0..1)
# ALERTS_WEBHOOK_ERROR_THRESHOLD=5     webhooks com erro/hora
# ALERTS_COOLDOWN_MINUTES=30           intervalo mínimo entre notificações
