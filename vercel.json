{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:deploy",
  "crons": [
    {
      "path": "/api/marketing/cron/drain",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/marketing/cron/sequences",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/marketing/cron/recover",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/marketing/cron/pipeline-cadences",
      "schedule": "0 11 * * *"
    }
  ]
}
